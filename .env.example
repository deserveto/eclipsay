# Eclipsay environment (copy to .env.local and fill in)

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; enables guest migration + account deletion routes
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Auto-router that only routes to free models; override with a specific :free model if needed
OPENROUTER_MODEL=openrouter/free

# Additional LLM providers (optional — any configured key enables its provider;
# pick per-surface models from /settings when signed in as an admin)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Poolside OpenAI-compatible endpoint (https://docs.poolside.ai/api/overview)
POOLSIDE_API_KEY=

# Comma-separated emails allowed to change the AI model from /settings.
# Unset disables the admin surface entirely.
ADMIN_EMAILS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
