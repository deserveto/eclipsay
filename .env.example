# Eclipsay environment (copy to .env.local and fill in)

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; enables guest migration + account deletion routes
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Auto-router that only routes to free models; override with a specific :free model if needed
OPENROUTER_MODEL=openrouter/free

NEXT_PUBLIC_APP_URL=http://localhost:3000
